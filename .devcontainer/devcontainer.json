{
  "name": "BEP Builder",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "postCreateCommand": "python -m pip install openpyxl defusedxml \"mcp>=2,<3\"",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "BEP Builder web app",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
